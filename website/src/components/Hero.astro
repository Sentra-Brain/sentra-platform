---
import { t, defaultLocale, type Locale } from '../i18n.ts';
const lang = Astro.params.lang ?? defaultLocale;
const locale = lang as Locale;
---

<section class="hero-section shadow-sentra bg-[var(--sentra-primary)] text-[var(--sentra-text)] py-24 rounded-2xl border-2 border-[var(--sentra-accent-light)] p-8 md:p-16 transition-all duration-300 hover:border-[var(--sentra-accent)]">
  <div class="container mx-auto px-4 text-center flex flex-col items-center">
    
    <h1 class="text-4xl md:text-6xl font-bold mb-4 leading-tight">
      Sentra Brain
    </h1>

    <img src="/sentra_brain_logo_256.png" alt="SentraBrain Logo" class="w-32 md:w-48 mb-8" loading="lazy" />

    
    <h1 class="text-3xl md:text-5xl font-bold mb-4 leading-tight">
      {t(locale, 'hero.title')}
    </h1>

    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-8">
      {t(locale, 'hero.subtitle')}
    </p>

    <a
      href={`/${lang}/contact`}
      class="inline-block px-8 py-4 bg-[var(--sentra-accent)] text-[var(--sentra-primary)] font-semibold rounded-lg hover:bg-[var(--sentra-accent-light)] transition"
    >
      {t(locale, 'hero.cta')}
    </a>
  </div>
</section>
