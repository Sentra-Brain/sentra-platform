---
import { t, defaultLocale, type Locale } from "../i18n.ts";
const lang = Astro.params.lang ?? defaultLocale;
const locale = lang as Locale;
---

<section class="py-16 text-[var(--sentra-text)]">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl md:text-5xl font-bold text-center mb-8">
      {t(locale, "about.hero.title")}
    </h1>

    <p class="max-w-2xl mx-auto text-center text-lg mb-12">
      {t(locale, "about.hero.subtitle")}
    </p>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-semibold mb-4">
          {t(locale, "about.problem.title")}
        </h2>
        <p>{t(locale, "about.problem.text")}</p>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-4">
          {t(locale, "about.solution.title")}
        </h2>
        <p>{t(locale, "about.solution.text")}</p>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mt-16 text-center">
      <div>
        <h3 class="text-xl font-semibold mb-2">
          {t(locale, "about.benefits.benefit1.title")}
        </h3>
        <p>{t(locale, "about.benefits.benefit1.text")}</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold mb-2">
          {t(locale, "about.benefits.benefit2.title")}
        </h3>
        <p>{t(locale, "about.benefits.benefit2.text")}</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold mb-2">
          {t(locale, "about.benefits.benefit3.title")}
        </h3>
        <p>{t(locale, "about.benefits.benefit3.text")}</p>
      </div>
    </div>
    <div class="text-center mt-16">
      <a
        href={`/${lang}/contact`}
        class="inline-block px-8 py-4 text-lg rounded-xl font-semibold bg-[var(--sentra-accent)] text-[var(--sentra-primary)] hover:bg-[var(--sentra-accent-light)] transition"
      >
        {t(locale, "about.cta")}
      </a>
    </div>
  </div>
</section>
