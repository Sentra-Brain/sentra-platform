    <style>
      html,
      body {
        height: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sentra-primary, #0f172a);
        color: var(--sentra-text, #f8fafc);
      }

      .brain-spinner {
        display: inline-block;
        position: relative;
        width: 220px;
        height: 220px;
      }
      .brain-spinner div {
        position: absolute;
        border: 10px solid var(--sentra-accent, #38bdf8);
        opacity: 1;
        border-radius: 50%;
        animation: brain-ring 1.2s cubic-bezier(0, 0.4, 0.8, 1) infinite;
      }
      .brain-spinner div:nth-child(2) {
        animation-delay: -0.4s;
      }
      .brain-spinner div:nth-child(3) {
        animation-delay: -0.8s;
      }
      .brain-spinner div:nth-child(4) {
        animation-delay: -1.2s;
      }

      @keyframes brain-ring {
        0% {
          top: 100px;
          left: 100px;
          width: 0;
          height: 0;
          opacity: 1;
        }
        100% {
          top: 0;
          left: 0;
          width: 200px;
          height: 200px;
          opacity: 0;
        }
      }
    </style>
  </head>

  <body>
    <main class="text-center">
      <div class="brain-spinner">
        <div></div><div></div><div></div><div></div>
      </div>
    </main>
    <script src="/js/redirect-by-language.js" is:inline></script>
    <script >
      redirectByLanguage("en", 50);
    </script>
  </body>
