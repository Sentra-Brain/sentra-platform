# Sentra Brain Production Configuration

# Core API URLs (internal resolution)
SENTRA_API_URL=http://sentra-api:8000
SENTRA_WEB_URL=http://sentra-web:3100
SENTRA_ADMIN_URL=http://sentra-admin:3001

# LLM Server
LLM_SERVER_URL=http://llama-server:11434

# Vector Store
CHROMA_DB_URL=http://sentra-vector-db:8001

# SQL Database (PostgreSQL)
POSTGRES_USER=sentra_admin
POSTGRES_PASSWORD=__SENTRA_PROD_SQL_PASSWORD__
POSTGRES_DB=sentra_brain

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=__SENTRA_PROD_MONGO_PASSWORD__
MONGO_DATABASE=sentra_brain_conversations

# MCP Servers (internal service resolution)
SENTRA_DOC_URL=http://sentra-doc:5001
SENTRA_CRM_URL=http://sentra-crm:5002
SENTRA_ACTION_URL=http://sentra-action:5003

# Environment Flags
NODE_ENV=production
PYTHON_ENV=production
