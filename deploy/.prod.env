# Sentra Brain Production Configuration

# Core API URLs (internal resolution)
SENTRA_API_URL=http://sentra-api:8100
SENTRA_WEB_URL=http://sentra-web:3100
SENTRA_ADMIN_URL=http://sentra-admin:3001

# LLM Server
LLM_SERVER_URL=http://llama-server:11434

# Vector Store
CHROMA_DB_URL=http://sentra-vector-db:8001

# SQL Database (PostgreSQL)
POSTGRES_USER=sentra_admin
POSTGRES_PASSWORD=__SENTRA_PROD_SQL_PASSWORD__
POSTGRES_DB=sentra_brain

# ======================
# MongoDB
# ======================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeit
MONGO_HOST=sentra-nosql-db
MONGO_PORT=27017
MONGO_DATABASE=sentra_brain

# Environment Flags
NODE_ENV=production
PYTHON_ENV=production
