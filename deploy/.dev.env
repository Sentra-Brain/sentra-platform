# Core API Configuration
SENTRA_API_URL=http://sentra-api:8100
SENTRA_WEB_URL=http://sentra-web:3100
SENTRA_ADMIN_URL=http://sentra-admin:3001

# LLM Server Configuration
LLM_SERVER_URL=http://llama-server:11434

# Vector Store (ChromaDB)
CHROMA_DB_URL=http://sentra-vector-db:8001

# PostgreSQL Configuration (sentra-sql-db)
POSTGRES_USER=sentra_admin
POSTGRES_PASSWORD=changeit
POSTGRES_DB=sentra_brain

# ======================
# MongoDB
# ======================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeit
MONGO_HOST=sentra-nosql-db
MONGO_PORT=27017
MONGO_DATABASE=sentra_brain

# MCP Servers (For sentra-api MCP Client)
SENTRA_DOC_URL=http://sentra-doc:5001
SENTRA_CRM_URL=http://sentra-crm:5002
SENTRA_ACTION_URL=http://sentra-action:5003

# Development Flags
NODE_ENV=development
PYTHON_ENV=development
