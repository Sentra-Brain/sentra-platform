# Add all package src folders to PYTHONPATH for monorepo development
PYTHONPATH=./packages/sentra-domain/src;./packages/sentra-infra/src;./packages/sentra-shared/src;./packages/sentra-runtime/src;./packages/sentra-rag/src
# PYTHONPATH=./packages/sentra-domain/src:./packages/sentra-infra/src:./packages/sentra-shared/src:./packages/sentra-runtime/src:./packages/sentra-rag/src

USE_DUMMY=false
LLM_ENGINE=vllm
VLLM_SERVER_URL=http://localhost:8002
VLLM_MODEL=hosted_vllm/models/meta-llama--Llama-3.1-8B-Instruct

# ADK-specific config
enable_rag=true
adk_token_budget=3000
max_tool_rounds=2
