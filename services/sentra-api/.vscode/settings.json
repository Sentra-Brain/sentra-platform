{
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [], // now controlled by pytest.ini

  // Optional: if you use coverage gutters
  "coverage-gutters.coverageFileNames": ["coverage.xml"],
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showLineCoverage": true,

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "livePreview.defaultPreviewPath": "/htmlcov/index.html",
  "peacock.color": "#1e1e2f",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#32324e",
    "activityBar.background": "#32324e",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#885757",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#32324e",
    "statusBar.background": "#1e1e2f",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#32324e",
    "statusBarItem.remoteBackground": "#1e1e2f",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#1e1e2f",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#1e1e2f99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "SentraDB",
      "database": "sentra_brain",
      "username": "sentra_admin",
      "password": "changeit"
    }
  ]
}
