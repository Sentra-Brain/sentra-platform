# .env.example
# This file is an example of the environment variables needed for the Sentra RAG server.

# ─── Debug ─────────────────────────────────────────────
DEBUG_MODE=true
PYTHONPATH=../../core/sentra-core:../../core/sentra-rag

# ─── ChromaDB Configuration ────────────────────────────
CHROMA_URL=http://sentra-vector-db:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_NAME=document_chunks
VECTOR_STORE_MODE=http # or sdk

# ─── Embedding Model ───────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ─── RAG Configuration ─────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_TOKENS=4000
DEFAULT_SEARCH_LIMIT=10

# Rough estimate: 1 token ≈ 4 characters (adjust if needed)
CHARACTERS_PER_TOKEN_APPROX=4
