---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeatureBox from "../../../components/FeatureBox.astro";
import { getLocalizedPaths } from "../../../utils/localization.ts";
import { t, defaultLocale, type Locale } from "../../../i18n.ts";

export const getStaticPaths = getLocalizedPaths;

const lang = Astro.params.lang ?? defaultLocale;
const locale = lang as Locale;
---

<BaseLayout lang={locale} title={t(locale, "verticals.accounting.title")}>
  <section class="py-12 text-[var(--sentra-text)]">
    <div class="container mx-auto px-4 max-w-6xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-6">
        {t(locale, "verticals.accounting.title")}
      </h1>
      <p class="text-lg mb-10">
        {t(locale, "verticals.accounting.intro")}
      </p>

      <!-- Challenges Section -->
      <h2 class="text-2xl font-bold mb-6">{t(locale, "verticals.accounting.challenges.title")}</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
        <FeatureBox
          icon="💰"
          title="Complex Tax Management"
          desc={t(locale, "verticals.accounting.challenges.tax")}
        />
        <FeatureBox
          icon="📋"
          title="Payroll Processing"
          desc={t(locale, "verticals.accounting.challenges.payroll")}
        />
        <FeatureBox
          icon="📄"
          title="Government Forms"
          desc={t(locale, "verticals.accounting.challenges.forms")}
        />
        <FeatureBox
          icon="🔒"
          title="Client Confidentiality"
          desc={t(locale, "verticals.accounting.challenges.confidential")}
        />
      </div>

      <!-- Solutions Section -->
      <h2 class="text-2xl font-bold mb-6">{t(locale, "verticals.accounting.solutions.title")}</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
        <FeatureBox
          icon="📄"
          title="Document Processing"
          desc={t(locale, "verticals.accounting.solutions.doc_processing")}
        />
        <FeatureBox
          icon="✏️"
          title="Form Pre-filling"
          desc={t(locale, "verticals.accounting.solutions.form_filling")}
        />
        <FeatureBox
          icon="📢"
          title="Regulatory Updates"
          desc={t(locale, "verticals.accounting.solutions.reg_updates")}
        />
        <FeatureBox
          icon="📊"
          title="Audit Documentation"
          desc={t(locale, "verticals.accounting.solutions.audit_ready")}
        />
      </div>

      <!-- Security Section -->
      <h2 class="text-2xl font-bold mb-6">{t(locale, "verticals.accounting.security.title")}</h2>
      <div class="grid gap-6 md:grid-cols-1 mb-12">
        <FeatureBox
          icon="🛡️"
          title={t(locale, "verticals.accounting.security.title")}
          desc={t(locale, "verticals.accounting.security.text")}
        />
      </div>

      <div class="text-center mt-10">
        <a href={`/${lang}/pilot`} class="inline-block px-8 py-4 rounded-xl font-semibold bg-[var(--sentra-accent)] text-[var(--sentra-primary)] hover:bg-[var(--sentra-accent-light)] transition">
          {t(locale, "verticals.accounting.cta")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>