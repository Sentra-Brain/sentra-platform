---
import { t, defaultLocale, type Locale } from '../i18n.ts';
const lang = Astro.params.lang ?? defaultLocale;
const locale = lang as Locale;
---

<section class="py-16 text-[var(--sentra-text)]">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl md:text-5xl font-bold text-center mb-8">
      {t(locale, 'architecture.hero.title')}
    </h1>

    <p class="max-w-2xl mx-auto text-center text-lg mb-12">
      {t(locale, 'architecture.hero.subtitle')}
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.llm.title')}</h3>
        <p>{t(locale, 'architecture.blocks.llm.text')}</p>
      </div>
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.mcp.title')}</h3>
        <p>{t(locale, 'architecture.blocks.mcp.text')}</p>
      </div>
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.rag.title')}</h3>
        <p>{t(locale, 'architecture.blocks.rag.text')}</p>
      </div>
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.automation.title')}</h3>
        <p>{t(locale, 'architecture.blocks.automation.text')}</p>
      </div>
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.security.title')}</h3>
        <p>{t(locale, 'architecture.blocks.security.text')}</p>
      </div>
      <div class="bg-[var(--sentra-neutral)] p-6 rounded-xl text-[var(--sentra-primary)]">
        <h3 class="text-xl font-semibold mb-2">{t(locale, 'architecture.blocks.support.title')}</h3>
        <p>{t(locale, 'architecture.blocks.support.text')}</p>
      </div>
    </div>
  </div>
</section>