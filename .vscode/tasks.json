// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: all (coverage)",
      "type": "shell",
      "command": "python -m pytest -q packages/sentra-domain/tests packages/sentra-infra/tests packages/sentra-runtime/tests packages/sentra-rag/tests services/sentra-api/tests --maxfail=1 --disable-warnings --cov=packages/sentra-runtime/sentra_runtime --cov=packages/sentra-rag/sentra_rag --cov=packages/sentra-domain/sentra_domain --cov=services/sentra-api/sentra_brain_api --cov-branch --cov-report=term-missing:skip-covered --cov-report=xml:coverage.xml",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "COVERAGE_FILE": "${workspaceFolder}/.coverage",
          "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "coverage: combine+xml",
      "type": "shell",
      "command": "coverage combine && coverage xml -o coverage.xml",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "COVERAGE_FILE": "${workspaceFolder}/.coverage",
          "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
        }
      },
      "problemMatcher": []
    }
  ]
}
