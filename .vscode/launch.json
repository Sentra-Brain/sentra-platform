    },
    {
      "name": "Pytest: ALL (coverage)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "args": [
        "-q",
        "packages/sentra-domain/tests",
        "packages/sentra-infra/tests",
        "packages/sentra-shared/tests",
        "packages/sentra-runtime/tests",
        "packages/sentra-rag/tests",
        "services/sentra-api/tests",
        "--maxfail=1",
        "--disable-warnings",
        "--cov=sentra_domain",
        "--cov=sentra_infra",
        "--cov=sentra_shared",
        "--cov=sentra_runtime",
        "--cov=sentra_rag",
        "--cov=sentra_brain_api",
        "--cov-branch",
        "--cov-report=term-missing:skip-covered",
        "--cov-report=xml:coverage.xml"
      ],
      "env": {
        "COVERAGE_FILE": "${workspaceFolder}/.coverage",
        "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: ALL",
