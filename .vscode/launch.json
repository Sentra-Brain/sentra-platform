{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach: Sentra API (Container)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/services/sentra-api",
          "remoteRoot": "/app"
        },
        {
          "localRoot": "${workspaceFolder}/packages",
          "remoteRoot": "/packages"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "Astro Dev (Terminal)",
      "command": "./node_modules/.bin/astro dev",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontends/website",
      "type": "node-terminal"
    },
    {
      "name": "Sentra Web Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/frontends/sentra-web"
    },
    {
      "name": "Sentra Admin Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/frontends/sentra-admin"
    },
    {
      "name": "Sentra API (Debug)",
      "type": "debugpy",
      "request": "launch",
      // "program": "${workspaceFolder}/services/sentra-api/sentra_brain_api/main.py",
      "module": "sentra_brain_api.main",
      "cwd": "${workspaceFolder}/services/sentra-api",
      "console": "integratedTerminal",
      "env": { "DEBUG_MODE": "true" },
      "justMyCode": false
    },
    // ...existing code...

    {
      "name": "Test: sentra-runtime",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/packages/sentra-runtime/tests",
      "envFile": "${workspaceFolder}/packages/sentra-runtime/tests/.env.test",
      "console": "integratedTerminal"
    },
