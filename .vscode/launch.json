{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro Dev (Terminal)",
      "command": "./node_modules/.bin/astro dev",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontends/website",
      "type": "node-terminal"
    },
    {
      "name": "Sentra Web Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/frontends/sentra-web"
    },
    {
      "name": "Sentra Admin Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/frontends/sentra-admin"
    },
    {
      "name": "Sentra API (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/services/sentra-api/sentra_brain_api/main.py",
      "cwd": "${workspaceFolder}/services/sentra-api",
      "console": "integratedTerminal",
      "env": { "DEBUG_MODE": "true" },
      "justMyCode": false
    },
    {
      "name": "Test: sentra-core",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/core/sentra-core/tests",
      "envFile": "${workspaceFolder}/core/sentra-core/tests/.env.test",
      "console": "integratedTerminal",
    },

    {
      "name": "Test: sentra-engine",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/core/sentra-engine/tests",
      "envFile": "${workspaceFolder}/core/sentra-engine/tests/.env.test",
      "console": "integratedTerminal",
    },
    
    {
      "name": "Test: sentra-api",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/services/sentra-api/tests",
      "envFile": "${workspaceFolder}/services/sentra-api/tests/.env.test",
      "console": "integratedTerminal",
    },
     {
      "name": "Pytest: ALL (coverage)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "args": [
        "-q",
        "core/sentra-engine/tests",
        "services/sentra-core/tests",
        "services/sentra-api/tests",
        "--maxfail=1",
        "--disable-warnings",
        "--cov=core/sentra-engine/sentra_engine",
        "--cov=services/sentra-core/sentra_core",
        "--cov=services/sentra-api/sentra_brain_api",
        "--cov-branch",
        "--cov-report=term-missing:skip-covered",
        "--cov-report=xml:coverage.xml"
      ],
      "env": {
        "COVERAGE_FILE": "${workspaceFolder}/.coverage",
        "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
      {
      "name": "Test: sentra-engine (coverage)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/core/sentra-engine",
      "args": [
        "-q",
        "tests",
        "--maxfail=1",
        "--disable-warnings",
        "--cov=sentra_engine",
        "--cov-branch",
        "--cov-report=term-missing:skip-covered",
        "--cov-report=xml:${workspaceFolder}/coverage.xml"
      ],
      "envFile": "${workspaceFolder}/core/sentra-engine/tests/.env.test",
      "env": {
        "COVERAGE_FILE": "${workspaceFolder}/.coverage",
        "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },

    {
      "name": "Test: sentra-core (coverage)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/services/sentra-core",
      "args": [
        "-q",
        "tests",
        "--maxfail=1",
        "--disable-warnings",
        "--cov=sentra_core",
        "--cov-branch",
        "--cov-report=term-missing:skip-covered",
        "--cov-report=xml:${workspaceFolder}/coverage.xml"
      ],
      "envFile": "${workspaceFolder}/services/sentra-core/tests/.env.test",
      "env": {
        "COVERAGE_FILE": "${workspaceFolder}/.coverage",
        "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },

    {
      "name": "Test: sentra-api (coverage)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/services/sentra-api",
      "args": [
        "-q",
        "tests",
        "--maxfail=1",
        "--disable-warnings",
        "--cov=sentra_brain_api",
        "--cov-branch",
        "--cov-report=term-missing:skip-covered",
        "--cov-report=xml:${workspaceFolder}/coverage.xml"
      ],
      "envFile": "${workspaceFolder}/services/sentra-api/tests/.env.test",
      "env": {
        "COVERAGE_FILE": "${workspaceFolder}/.coverage",
        "COVERAGE_RCFILE": "${workspaceFolder}/.coveragerc"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Stream Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sentra-engine/examples/stream_demo.py",
      "cwd": "${workspaceFolder}/sentra-engine",
      "env": { "USE_DUMMY": "true" },
      "console": "integratedTerminal"
    }
  ]
}
