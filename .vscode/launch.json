{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro Dev (Terminal)",
      "command": "./node_modules/.bin/astro dev",
      "request": "launch",
      "cwd": "${workspaceFolder}/website",
      "type": "node-terminal"
    },
    {
      "name": "Sentra Web Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/apps/sentra-web"
    },
    {
      "name": "Sentra Admin Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "cwd": "${workspaceFolder}/apps/sentra-admin"
    },
    {
      "name": "Sentra API (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/services/sentra-api/sentra_brain_api/main.py",
      "cwd": "${workspaceFolder}/services/sentra-api",
      "console": "integratedTerminal",
      "env": { "DEBUG_MODE": "true" },
      "justMyCode": false
    },
    {
      "name": "Test: sentra-shared",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/services/sentra-shared/tests",
      "envFile": "${workspaceFolder}/services/sentra-shared/tests/.env.test",
      "console": "integratedTerminal",
    },
    
    {
      "name": "Test: sentra-api",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      },
      "module": "pytest",
      "cwd": "${workspaceFolder}/services/sentra-api/tests",
      "envFile": "${workspaceFolder}/services/sentra-api/tests/.env.test",
      "console": "integratedTerminal",
    },
  ]
}
