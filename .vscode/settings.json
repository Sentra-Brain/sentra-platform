{
  "search.exclude": {
    "node_modules": true,
    "dist": true,
    "pnpm-lock.yaml": true,
    "**/*.snapshot.json": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  "python.analysis.autoImportCompletions": true,
  "python.analysis.useLibraryCodeForTypes": true,

  "python.analysis.extraPaths": [
    "${workspaceFolder}/packages",
    "${workspaceFolder}/packages/sentra-domain/src",
    "${workspaceFolder}/packages/sentra-engine/src",
    "${workspaceFolder}/packages/sentra-infra/src",
    "${workspaceFolder}/packages/sentra-shared/src",
    "${workspaceFolder}/services"
  ]
}
